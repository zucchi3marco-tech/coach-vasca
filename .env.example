# Copia questo file in `.env` (mai in `.env.example`!) e riempi i valori veri.
# `.env` e' escluso da Git (vedi .gitignore) — non deve mai finire committato.
#
# Dove trovare i valori: Dashboard Supabase → progetto "Coach-vasca" →
# Project Settings → Data API (URL) e Project Settings → API Keys (anon key).

# URL del progetto Supabase, es. https://xxxxxxxxxxxx.supabase.co
SUPABASE_URL=

# Chiave "anon" / "publishable" — e' l'UNICA chiave che deve stare nel client
# (app Flutter). Protetta dalla RLS attiva su ogni tabella: senza un utente
# autenticato e membro del club, non legge/scrive nulla.
SUPABASE_ANON_KEY=

# NON aggiungere MAI la service_role key qui o in qualsiasi file dentro il
# repository: bypassa completamente la RLS e deve restare solo lato server
# (nessun server backend previsto in questa app, quindi non deve mai
# comparire da nessuna parte nel progetto).
